<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="Definitions_Panaderia" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.31.1">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_Panaderia" name="Panadería “El Sol”" processRef="Process_Panaderia" />
    <bpmn:participant id="Participant_Proveedor" name="Proveedor de insumos" processRef="Process_Proveedor" />
    <bpmn:messageFlow id="m1" name="Orden de compra" sourceRef="T7" targetRef="PS" />
    <bpmn:messageFlow id="m2" sourceRef="P5" targetRef="M" />
    <bpmn:textAnnotation id="TA1">
      <bpmn:text>Regla: hay alerta si stock_actual ≤ stock_minimo, o si fecha_vencimiento está próxima.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="a1" sourceRef="TA1" targetRef="T3" />
  </bpmn:collaboration>
  <bpmn:dataStore id="DataStore_Inventario" name="Inventario" />
  <bpmn:process id="Process_Panaderia" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Sistema" name="Sistema de stock (automatizado)">
        <bpmn:flowNodeRef>T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TV</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>LC</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TM</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TD</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>M</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E5</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Encargado" name="Encargado de negocio">
        <bpmn:flowNodeRef>T5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>LT</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Panadero" name="Panadero">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Se necesitan insumos para producir">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="T1" name="Registrar salida de insumos">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="T2" name="Descontar stock y registrar movimiento">
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="d1">
        <bpmn:targetRef>DS1</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="T3" name="Evaluar stock y vencimientos">
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>f4</bpmn:outgoing>
      <bpmn:property id="Property_06cs6gb" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="d2">
        <bpmn:sourceRef>DS1</bpmn:sourceRef>
        <bpmn:targetRef>Property_06cs6gb</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="G1" name="¿Qué arrojó la evaluación?">
      <bpmn:incoming>f4</bpmn:incoming>
      <bpmn:outgoing>f5</bpmn:outgoing>
      <bpmn:outgoing>f6</bpmn:outgoing>
      <bpmn:outgoing>f7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="E1" name="Stock en nivel normal">
      <bpmn:incoming>f5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:scriptTask id="TV" name="Emitir alerta de vencimiento">
      <bpmn:incoming>f7</bpmn:incoming>
      <bpmn:outgoing>f8</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:endEvent id="E2" name="Alerta de vencimiento emitida">
      <bpmn:incoming>f8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:scriptTask id="T4" name="Generar alerta de reposición">
      <bpmn:incoming>f6</bpmn:incoming>
      <bpmn:outgoing>f9</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:userTask id="T5" name="Revisar alerta de reposición">
      <bpmn:incoming>f9</bpmn:incoming>
      <bpmn:outgoing>f10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G2" name="¿Se aprueba el pedido?">
      <bpmn:incoming>f10</bpmn:incoming>
      <bpmn:outgoing>f11</bpmn:outgoing>
      <bpmn:outgoing>f12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="E3" name="Pedido postergado">
      <bpmn:incoming>f11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="LC" name="Reintentar pedido">
      <bpmn:outgoing>f12b</bpmn:outgoing>
      <bpmn:linkEventDefinition id="LC_def" name="Reintentar pedido" />
    </bpmn:intermediateCatchEvent>
    <bpmn:scriptTask id="T6" name="Generar orden de compra">
      <bpmn:incoming>f12</bpmn:incoming>
      <bpmn:incoming>f12b</bpmn:incoming>
      <bpmn:outgoing>f13</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:sendTask id="T7" name="Enviar orden de compra al proveedor">
      <bpmn:incoming>f13</bpmn:incoming>
      <bpmn:outgoing>f14</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:eventBasedGateway id="G3">
      <bpmn:incoming>f14</bpmn:incoming>
      <bpmn:outgoing>f15</bpmn:outgoing>
      <bpmn:outgoing>f16</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="TM" name="Plazo de entrega vencido (3 días)">
      <bpmn:incoming>f16</bpmn:incoming>
      <bpmn:outgoing>f17</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TM_def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P3D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:scriptTask id="TD" name="Generar alerta de demora">
      <bpmn:incoming>f17</bpmn:incoming>
      <bpmn:outgoing>f18</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:endEvent id="E4" name="Demora informada al encargado">
      <bpmn:incoming>f18</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="M" name="Respuesta del proveedor">
      <bpmn:incoming>f15</bpmn:incoming>
      <bpmn:outgoing>f19</bpmn:outgoing>
      <bpmn:messageEventDefinition id="M_def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="T8" name="Controlar entrega recibida">
      <bpmn:incoming>f19</bpmn:incoming>
      <bpmn:outgoing>f20</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G4" name="¿La entrega es conforme a la orden de compra?">
      <bpmn:incoming>f20</bpmn:incoming>
      <bpmn:outgoing>f21</bpmn:outgoing>
      <bpmn:outgoing>f22</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T9" name="Registrar entrada de insumos">
      <bpmn:incoming>f21</bpmn:incoming>
      <bpmn:outgoing>f24</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="d3">
        <bpmn:targetRef>DS2</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:endEvent id="E5" name="Stock repuesto">
      <bpmn:incoming>f24</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="T10" name="Gestionar solución con el proveedor">
      <bpmn:incoming>f22</bpmn:incoming>
      <bpmn:outgoing>f23</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateThrowEvent id="LT" name="Reintentar pedido">
      <bpmn:incoming>f23</bpmn:incoming>
      <bpmn:linkEventDefinition id="LT_def" name="Reintentar pedido" />
    </bpmn:intermediateThrowEvent>
    <bpmn:dataStoreReference id="DS1" name="Inventario" dataStoreRef="DataStore_Inventario" />
    <bpmn:dataStoreReference id="DS2" name="Inventario" dataStoreRef="DataStore_Inventario" />
