  <bpmn:process id="Process_Proveedor" isExecutable="false">
    <bpmn:startEvent id="PS" name="Orden de compra recibida">
      <bpmn:outgoing>g1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="PS_def" />
    </bpmn:startEvent>
    <bpmn:userTask id="P2" name="Verificar disponibilidad">
      <bpmn:incoming>g1</bpmn:incoming>
      <bpmn:outgoing>g2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GP" name="¿Hay disponibilidad?">
      <bpmn:incoming>g2</bpmn:incoming>
      <bpmn:outgoing>g3</bpmn:outgoing>
      <bpmn:outgoing>g4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="P3" name="Preparar insumos del pedido">
      <bpmn:incoming>g3</bpmn:incoming>
      <bpmn:outgoing>g5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="P4" name="Registrar falta de insumos">
      <bpmn:incoming>g4</bpmn:incoming>
      <bpmn:outgoing>g6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GM" name="">
      <bpmn:incoming>g5</bpmn:incoming>
      <bpmn:incoming>g6</bpmn:incoming>
      <bpmn:outgoing>g7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="P5" name="Enviar respuesta a la panadería">
      <bpmn:incoming>g7</bpmn:incoming>
      <bpmn:outgoing>g8</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="PE" name="Respuesta enviada">
      <bpmn:incoming>g8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="g1" sourceRef="PS" targetRef="P2" />
    <bpmn:sequenceFlow id="g2" sourceRef="P2" targetRef="GP" />
